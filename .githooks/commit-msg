#!/bin/sh

message_file="$1"
trailer='GitHub-Copilot: true'
model_trailer="Model: ${COPILOT_MODEL_NAME:-unknown}"

if ! grep -Fqx "$trailer" "$message_file"; then
  printf '\n%s\n' "$trailer" >> "$message_file"
fi

if ! grep -Fq 'Model: ' "$message_file"; then
  printf '%s\n' "$model_trailer" >> "$message_file"
fi
